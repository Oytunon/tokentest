# Test token(lari). Kopyala: copy .env.example .env  sonra TOKENS satirina yapistir.
# Birden fazla token: virgul, bosluk ya da ayri TOKEN1/TOKEN2 satirlariyla verilebilir.
TOKENS=

# Opsiyonel: auth basligi adi (varsayilan Authentication)
AUTH_HEADER=
# Opsiyonel: telefon alan adini elle sabitle ( or. MobileNumber). Bos ise otomatik bulunur.
PHONE_FIELD=
